# FAC Audit Alert — configuration
# Copy this file to .env and fill in your values

# API key from https://api.data.gov/signup/
FAC_API_KEY=your_data_gov_api_key_here

# Two-letter state code to monitor (e.g. CA, TX, NY)
WATCH_STATE=CA

# Gmail address used to SEND the alert
EMAIL_FROM=you@gmail.com

# Gmail App Password (NOT your regular password)
# Create one at: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Recipient email address(es) — comma-separated for multiple
EMAIL_TO=recipient@example.com

# Optional overrides
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# STATE_FILE=last_check.json

# ---------------------------------------------------------------------------
# FEC Tracker — configuration
# ---------------------------------------------------------------------------

# API key from https://api.data.gov/signup/ (same signup as FAC_API_KEY above —
# you can reuse one key for both, or register a second one)
FEC_API_KEY=your_data_gov_api_key_here

# Optional overrides
# FEC_STATE=ME
# FEC_SENATE_CYCLE=2026
# FEC_STATE_FILE=fec_state.json
# (EMAIL_FROM / EMAIL_PASSWORD / EMAIL_TO / SMTP_HOST / SMTP_PORT above are shared with fec_tracker.py)
